                  "body/recipient/channelId": "19:WmBzqRsRwLlrcC41pn-9DWhAxWoDrAg8j1CKAPbufdY1@thread.tacv2",
                  "body/messageBody": "\u003Cp class=\u0022editor-paragraph\u0022\u003E\u26A0\uFE0F \u003Cb\u003E\u003Cstrong class=\u0022editor-text-bold\u0022\u003ENova solicita\u00E7\u00E3o de empr\u00E9stimo!\u003C/strong\u003E\u003C/b\u003E\u003C/p\u003E\u003Cbr\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003EEssa solicita\u00E7\u00E3o requer valida\u00E7\u00E3o adicional (quantidade acima de 2 itens).\u003C/p\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003E\u003Cbr\u003E\u003Cb\u003E\u003Cstrong class=\u0022editor-text-bold\u0022\u003EProtocolo:\u003C/strong\u003E\u003C/b\u003E @{outputs(\u0027protocolo\u0027)}\u003C/p\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003E\u003Cb\u003E\u003Cstrong class=\u0022editor-text-bold\u0022\u003ESolicitante:\u003C/strong\u003E\u003C/b\u003E @{outputs(\u0027Criar_item\u0027)?[\u0027body/Solicitacao\u0027]}\u003C/p\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003E\u003Cb\u003E\u003Cstrong class=\u0022editor-text-bold\u0022\u003EE-mail: \u003C/strong\u003E\u003C/b\u003E@{outputs(\u0027Criar_item\u0027)?[\u0027body/E_x002d_mail\u0027]}\u003C/p\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003E\u003Cb\u003E\u003Cstrong class=\u0022editor-text-bold\u0022\u003EN\u00FAmero do celular: \u003C/strong\u003E\u003C/b\u003E@{outputs(\u0027Criar_item\u0027)?[\u0027body/N_x00fa_meroCelular\u0027]}\u003C/p\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003E\u003Cb\u003E\u003Cstrong class=\u0022editor-text-bold\u0022\u003EEquipamento:\u003C/strong\u003E\u003C/b\u003E @{outputs(\u0027Criar_item\u0027)?[\u0027body/Equipamento/Value\u0027]}\u003C/p\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003E\u003Cb\u003E\u003Cstrong class=\u0022editor-text-bold\u0022\u003EQuantidade:\u003C/strong\u003E\u003C/b\u003E @{outputs(\u0027Criar_item\u0027)?[\u0027body/Quantidade\u0027]}\u003C/p\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003E\u003Cb\u003E\u003Cstrong class=\u0022editor-text-bold\u0022\u003EFinalidade: \u003C/strong\u003E\u003C/b\u003E@{outputs(\u0027Criar_item\u0027)?[\u0027body/Finalidade\u0027]}\u003C/p\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003E\u003Cb\u003E\u003Cstrong class=\u0022editor-text-bold\u0022\u003EData Retirada: \u003C/strong\u003E\u003C/b\u003E@{outputs(\u0027Criar_item\u0027)?[\u0027body/DataRetirada\u0027]}\u003C/p\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003E\u003Cb\u003E\u003Cstrong class=\u0022editor-text-bold\u0022\u003EData Devolu\u00E7\u00E3o: \u003C/strong\u003E\u003C/b\u003E@{outputs(\u0027Criar_item\u0027)?[\u0027body/DataDevolucao\u0027]}\u003C/p\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003E\u003Cb\u003E\u003Cstrong class=\u0022editor-text-bold\u0022\u003EStatus:\u003C/strong\u003E\u003C/b\u003E Pendente\u003Cbr\u003E\u003C/p\u003E\u003Cbr\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003E\u003Ci\u003E\u003Cem class=\u0022editor-text-italic\u0022\u003EMensagem enviada automaticamente pelo agente EmprestAI.\u003C/em\u003E\u003C/i\u003E\u003C/p\u003E"
                },
