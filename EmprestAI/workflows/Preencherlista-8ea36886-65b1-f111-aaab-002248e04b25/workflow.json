        "Enviar_um_email_(V2)": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "emailMessage/To": "@outputs(\u0027Criar_item\u0027)?[\u0027body/E_x002d_mail\u0027]",
              "emailMessage/Subject": "Confirma\u00E7\u00E3o de solicita\u00E7\u00E3o de empr\u00E9stimo - Protocolo @{outputs(\u0027protocolo\u0027)}",
              "emailMessage/Body": "\u003Cp class=\u0022editor-paragraph\u0022\u003ESegue informa\u00E7\u00F5es sobre o seu empr\u00E9stimo de equipamento:\u003C/p\u003E\u003Cbr\u003E\u003Cp class=\u0022editor-paragraph\u0022\u003EProtocolo: @{outputs(\u0027protocolo\u0027)}\u003Cbr\u003ESolicitante: @{outputs(\u0027Criar_item\u0027)?[\u0027body/Solicitacao\u0027]}\u003Cbr\u003EE-mail: @{outputs(\u0027Criar_item\u0027)?[\u0027body/E_x002d_mail\u0027]}\u003Cbr\u003EN\u00FAmero do celular: @{outputs(\u0027Criar_item\u0027)?[\u0027body/N_x00fa_meroCelular\u0027]}\u003Cbr\u003EEquipamento: @{outputs(\u0027Criar_item\u0027)?[\u0027body/Equipamento/Value\u0027]}\u003Cbr\u003EQuantidade: @{outputs(\u0027Criar_item\u0027)?[\u0027body/Quantidade\u0027]}\u003Cbr\u003EFinalidade: @{outputs(\u0027Criar_item\u0027)?[\u0027body/Finalidade\u0027]}\u003Cbr\u003EData Retirada: @{outputs(\u0027Criar_item\u0027)?[\u0027body/DataRetirada\u0027]}\u003Cbr\u003EData Devolu\u00E7\u00E3o: @{outputs(\u0027Criar_item\u0027)?[\u0027body/DataDevolucao\u0027]}\u003Cbr\u003EStatus: Pendente\u003Cbr\u003E\u003Cbr\u003E\u003Cbr\u003EMensagem enviada automaticamente pelo agente EmprestAI.\u003C/p\u003E",
              "emailMessage/Importance": "Normal"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "operationId": "SendEmailV2",
              "connectionName": "shared_office365"
